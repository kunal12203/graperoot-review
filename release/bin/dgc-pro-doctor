#!/usr/bin/env bash
# GrapeRoot Pro Doctor — wrapper script
# Auto-uses venv python if available, falls back to system python3

PRO_HOME="${HOME}/.graperoot-pro"
VENV_PYTHON="${PRO_HOME}/venv/bin/python3"
DOCTOR_SCRIPT="${PRO_HOME}/bin/dgc-pro-doctor.py"

if [[ ! -f "$DOCTOR_SCRIPT" ]]; then
  echo "Error: dgc-pro-doctor.py not found at $DOCTOR_SCRIPT"
  echo "Reinstall GrapeRoot Pro or download from:"
  echo "  https://graperoot.dev/pro/install.sh"
  exit 1
fi

if [[ -x "$VENV_PYTHON" ]]; then
  exec "$VENV_PYTHON" "$DOCTOR_SCRIPT" "$@"
else
  exec python3 "$DOCTOR_SCRIPT" "$@"
fi
